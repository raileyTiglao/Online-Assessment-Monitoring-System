rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function role()       { return request.auth.token.role; }
    function isAdmin()     { return isSignedIn() && role() == 'admin'; }
    function isProfessor() { return isSignedIn() && role() == 'professor'; }

    // users/{uid} — profile + role mirror of the Auth custom claim.
    // Provisioned only by connection/bootstrap_admin.py (Admin SDK, bypasses
    // these rules), never created by the client.
    match /users/{uid} {
      allow read:  if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // exams/{examCode} — doc ID is the human-typeable code the Python
    // monitoring app looks up directly. A professor may create/manage/
    // delete only exams they own; an admin may do the same for any exam.
    // Deleting an exam also deletes its sessions (see below) — the
    // dashboard does both as one client-side batch, not a rule concern,
    // but both deletes have to be independently authorized here.
    match /exams/{examCode} {
      allow read:   if isAdmin() || (isProfessor() && resource.data.professorUid == request.auth.uid);
      allow create: if (isAdmin() || isProfessor()) && request.resource.data.professorUid == request.auth.uid;
      allow update: if isAdmin() ||
                       (isProfessor() && resource.data.professorUid == request.auth.uid &&
                        request.resource.data.professorUid == resource.data.professorUid);
      allow delete: if isAdmin() || (isProfessor() && resource.data.professorUid == request.auth.uid);
    }

    // sessions/{sessionUid} — created/updated only by the Python app via
    // the Admin SDK, which bypasses these rules entirely; client create/
    // update is always denied. Deletion IS allowed from the client, but
    // only by the owning professor or an admin — this is what backs the
    // dashboard's "delete exam" cascade (see ExamsAndSessionsPage).
    match /sessions/{sessionUid} {
      allow read:          if isAdmin() || (isProfessor() && resource.data.professor_uid == request.auth.uid);
      allow create, update: if false;
      allow delete:        if isAdmin() || (isProfessor() && resource.data.professor_uid == request.auth.uid);
    }
  }
}
