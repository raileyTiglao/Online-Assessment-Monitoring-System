# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
venv_download/
env/
.pytest_cache/
*.egg-info/

# Downloaded training dataset (regenerate via download_openimages.py /
# download_negatives.py rather than committing hundreds of MBs of images)
openimages_voc/

# Model weights (large files — don't commit, share separately or use Git LFS)
*.pth
*.pt
models/

# Training run outputs (train_fasterrcnn.py --output-dir, default below).
# Holds best_model.pth, last_checkpoint.pth and epochs/ — all regenerable
# by re-running training, and far too large for git.
trained_model/

# Session outputs (generated at runtime, not source code)
session_report.json
evidence_captures/

# Local development log — working notebook, not project documentation
logs.md

# Annotated videos written by test_on_video.py --out
*.mp4
*.avi
*.mkv

# --- Secrets: never commit ---
# The Firebase key is expected at the first path. The wildcard is a safety
# net: keys download from the console as e.g.
# "<project>-firebase-adminsdk-xxxxx.json", and would otherwise be
# committable until someone remembers to rename them.
connection/firebase_credentials.json
*firebase-adminsdk*.json
*serviceAccount*.json
.env
.env.*

# Local databases
*.db
*.sqlite
*.sqlite3

# Local PHP/MySQL backend — uploaded evidence screenshots aren't source
php_backend/uploads/evidence/*
!php_backend/uploads/evidence/.gitkeep

# Firebase CLI / emulator local artifacts
.firebase/
firebase-debug.log
firestore-debug.log
storage-debug.log
ui-debug.log
*-debug.log
emulator_data/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/